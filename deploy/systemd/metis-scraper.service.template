[Unit]
Description=Metis AI public Scrapling scraper
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
Group=YOUR_GROUP
WorkingDirectory=YOUR_INSTALL_DIR
Environment=HOME=/run/metis-scraper
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=METIS_SCRAPER_HOST=127.0.0.1
Environment=METIS_SCRAPER_PORT=8890
ExecStart=YOUR_INSTALL_DIR/.venv-scrapling/bin/python YOUR_INSTALL_DIR/scripts/scrapling-service.py
Restart=always
RestartSec=3
RuntimeDirectory=metis-scraper
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
MemoryHigh=256M
MemoryMax=384M
TasksMax=64

[Install]
WantedBy=multi-user.target
